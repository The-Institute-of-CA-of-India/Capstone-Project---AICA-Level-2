{
  "name": "CashSense - Telegram inbox (approvals, commands, statement uploads)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "seconds", "secondsInterval": 10 } ] }
      },
      "name": "Every 10 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 0, 0 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/api/telegram/poll",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 240000 }
      },
      "name": "CashSense - process Telegram updates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 240, 0 ],
      "credentials": { "httpHeaderAuth": { "id": "cashsenseApiKey01", "name": "CashSense API key" } },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "conditions": [
            { "leftValue": "={{ ($json.decisions || []).length + ($json.imports || []).length }}",
              "rightValue": 0, "operator": { "type": "number", "operation": "gt" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Anything decided or imported?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [ 480, 0 ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "decisions", "value": "={{ ($json.decisions || []).map(d => d.approval_id + ': ' + d.status).join(', ') }}", "type": "string" },
            { "id": "a2", "name": "imports", "value": "={{ ($json.imports || []).length }}", "type": "number" }
          ]
        },
        "options": {}
      },
      "name": "Log activity",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [ 720, -80 ]
    }
  ],
  "connections": {
    "Every 10 seconds": { "main": [ [ { "node": "CashSense - process Telegram updates", "type": "main", "index": 0 } ] ] },
    "CashSense - process Telegram updates": { "main": [ [ { "node": "Anything decided or imported?", "type": "main", "index": 0 } ] ] },
    "Anything decided or imported?": { "main": [ [ { "node": "Log activity", "type": "main", "index": 0 } ], [] ] }
  },
  "settings": { "executionOrder": "v1", "saveDataSuccessExecution": "none", "timezone": "Asia/Kolkata" },
  "active": false
}
