# Copy to .env and fill in. Never commit .env. All values are read server-side only.

# ---------- Backend ----------
# local    = SQLite + local private file storage (development / single server, works with no external services)
# supabase = Supabase Postgres (RLS enforced) + Supabase Auth + private Supabase Storage
DATA_BACKEND=local
APP_ENV=development
APP_BASE_URL=http://localhost:8501          # used in invitation and password-reset links

# Local backend paths (optional)
SQLITE_PATH=./data/accounting_setu.db
LOCAL_STORAGE_DIR=./data/storage

# ---------- Supabase (required when DATA_BACKEND=supabase) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=                          # Project Settings → API → anon public key
# Server-side only (Streamlit runs on the server; this key is never sent to browsers).
# Used to create staff/client logins and for storage access after the app's own authorization checks.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Project Settings → Database → Connection string → URI, session pooler)
SUPABASE_DB_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
SUPABASE_STORAGE_BUCKET=documents

# ---------- AI / OCR ----------
AI_PROVIDER=auto                            # auto | anthropic | local
ANTHROPIC_API_KEY=                          # optional; without it the local rule-based extractor is used
ANTHROPIC_MODEL=claude-opus-5-5
OCR_PROVIDER=auto                           # auto | tesseract | none
TESSERACT_CMD=                              # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------- Uploads ----------
MAX_UPLOAD_MB=25

# ---------- Email (optional; without SMTP, mails are written to data/outbox/) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---------- Platform bootstrap ----------
# Optional: create the Super Admin on first start (otherwise a one-time setup screen appears)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SESSION_TIMEOUT_MINUTES=60
LOAD_DEMO_DATA=false                        # true loads demo firms/clients on first start (local backend only)
GST_RULES_VERSION=2025.1
