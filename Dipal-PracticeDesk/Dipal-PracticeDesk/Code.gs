/** PracticeDesk Google Edition 2.0. Per-user Sheets and MailApp identity. */
const PD = {version:2,maxBytes:1000000,chunk:24000,dbKey:'PD_DATABASE_V2',ownerKey:'OWNER_EMAIL',snapshot:'_Snapshots',mail:'EmailLog'};
function doGet(){return HtmlService.createHtmlOutputFromFile('Index').setTitle('PracticeDesk | Google Edition').addMetaTag('viewport','width=device-width, initial-scale=1');}
function identity_(){
 const active=String(Session.getActiveUser().getEmail()||'').trim().toLowerCase();
 const effective=String(Session.getEffectiveUser().getEmail()||'').trim().toLowerCase();
 if(!active||active!==effective)throw Error('IDENTITY: Sign in to Google and deploy with Execute as: User accessing the web app. The active and sending accounts must match.');
 return active;
}
function locked_(fn){let lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw Error('BUSY: Another request is running. Please retry shortly.');try{return fn()}finally{lock.releaseLock()}}
function db_(email,required){let key=PropertiesService.getUserProperties().getProperty(PD.dbKey);if(!key){if(required)throw Error('SETUP: Create your personal database first.');return null}let ss;try{ss=SpreadsheetApp.openById(key)}catch(e){throw Error('DATABASE: Your Sheet is unavailable. Restore its access before continuing; no replacement database has been created.')}let meta=ss.getSheetByName('_Meta');if(!meta||String(meta.getRange(2,2).getValue()).toLowerCase()!==email)throw Error('OWNER: The database owner does not match the signed-in user.');return ss;}
function empty_(){return {version:1,settings:{firm:'Your CA Practice',sender:'Practice Team'},clients:[],assignments:[],activity:[]};}
function txt_(v,n,max,empty){if(typeof v!=='string'||v.length>max||(!empty&&!v.trim()))throw Error('VALIDATION: Invalid '+n);return v}
function dt_(s,empty){if(empty&&s==='')return true;if(typeof s!=='string'||!/^\d{4}-\d{2}-\d{2}$/.test(s)||s<'1900-01-01'||s>'2200-12-31')return false;let d=new Date(s+'T12:00:00Z');return !isNaN(d)&&d.toISOString().slice(0,10)===s;}
function state_(input){
 const s=JSON.parse(JSON.stringify(input));
 if(!s||s.version!==1||!s.settings||!Array.isArray(s.clients)||!Array.isArray(s.assignments)||!Array.isArray(s.activity))throw Error('VALIDATION: Unsupported backup schema.');
 if(JSON.stringify(s).length>PD.maxBytes||s.clients.length>1000||s.assignments.length>1000)throw Error('LIMIT: Use a workspace below 1 MB and 1,000 clients / assignments.');
 txt_(s.settings.firm,'practice name',300,false);txt_(s.settings.sender,'sign-off',300,false);
 const ids=new Set(),unique=v=>{if(typeof v!=='string'||!/^[A-Za-z0-9_-]{1,100}$/.test(v)||ids.has(v))throw Error('VALIDATION: Invalid / duplicate ID.');ids.add(v)};
 let clients=new Set(),totalDocs=0,totalContacts=0;
 for(const c of s.clients){unique(c.id);clients.add(c.id);for(const k of ['name','contact','email','phone'])txt_(c[k],'client '+k,300,k!=='name');if(c.email&&!email_(c.email))throw Error('VALIDATION: Invalid client email.');}
 for(const a of s.assignments){unique(a.id);if(!clients.has(a.clientId)||!Array.isArray(a.docs)||!dt_(a.due,true))throw Error('VALIDATION: Invalid assignment relationship / date.');for(const k of ['title','period','owner','notes','created'])txt_(a[k],'assignment '+k,k==='notes'?5000:300,k!=='title');if(a.nextFollowUp === undefined || a.nextFollowUp === null) a.nextFollowUp = '';if(a.followUps === undefined || a.followUps === null) a.followUps = [];if(!dt_(a.nextFollowUp,true)||!Array.isArray(a.followUps))throw Error('VALIDATION: Invalid follow-up.');
  for(const d of a.docs){totalDocs++;unique(d.id);txt_(d.name,'document',300,false);txt_(d.notes,'document note',5000,true);if(typeof d.required!=='boolean'||!['Pending','Partially received','Received','Reviewed','Not applicable'].includes(d.status)||!dt_(d.due,true)||!dt_(d.receivedOn,true))throw Error('VALIDATION: Invalid document record.');}
  for(const f of a.followUps){totalContacts++;unique(f.id);if(!dt_(f.date,false)||!['Email','Phone','WhatsApp','Meeting','Other'].includes(f.channel)||typeof f.recordedAt!=='string'||isNaN(Date.parse(f.recordedAt)))throw Error('VALIDATION: Invalid contact record.');txt_(f.by,'contact owner',300,false);txt_(f.notes,'contact outcome',5000,false);}
 }
 if(totalDocs>10000||totalContacts>10000)throw Error('LIMIT: Maximum 10,000 documents / contacts per workspace.');
 if(s.activity.length>500)throw Error('VALIDATION: Maximum 500 recent activities.');for(const x of s.activity){txt_(x.text,'activity',2000,false);if(typeof x.at!=='string'||isNaN(Date.parse(x.at)))throw Error('VALIDATION: Invalid activity time.');}
 return s;
}
function email_(s){return typeof s==='string'&&s.length<=254&&/^[^\s@,;<>]+@[^\s@,;<>]+\.[^\s@,;<>]+$/.test(s)&&!/[\r\n]/.test(s)}
function hash_(s){return Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8))}
function sheet_(ss,name,headers){let sh=ss.getSheetByName(name)||ss.insertSheet(name);if(!sh.getLastRow()&&headers)sh.getRange(1,1,1,headers.length).setValues([headers]);return sh;}
function latest_(ss){
 const sh=ss.getSheetByName(PD.snapshot);if(!sh||sh.getLastRow()<2)return {revision:0,state:empty_(),saveId:'',at:''};
 const rows=sh.getDataRange().getValues();
 // Latest committed snapshot is authoritative. Corruption fails closed; never silently roll back.
 for(let end=rows.length-1;end>=1;end--){if(rows[end][0]!=='COMMIT')continue;let rev=Number(rows[end][1]),n=Number(rows[end][2]),start=end-n-1,head=rows[start];if(!head||head[0]!=='BEGIN'||Number(head[1])!==rev||Number(head[2])!==n)throw Error('INTEGRITY: Invalid snapshot structure. Restore a verified backup.');let encoded='';for(let i=0;i<n;i++){let row=rows[start+1+i];if(row[0]!=='DATA'||Number(row[1])!==rev||Number(row[2])!==i||!String(row[3]).startsWith('B64:'))throw Error('INTEGRITY: Incomplete snapshot.');encoded+=String(row[3]).slice(4)}let text=Utilities.newBlob(Utilities.base64DecodeWebSafe(encoded)).getDataAsString('UTF-8');if(hash_(text)!==head[3]||head[3]!==rows[end][3])throw Error('INTEGRITY: Snapshot checksum mismatch.');return {revision:rev,state:state_(JSON.parse(text)),saveId:String(head[5]),at:String(head[4])};}
 throw Error('INTEGRITY: No committed snapshot was found.');
}
function appendSnapshot_(ss,s,revision,saveId){const text=JSON.stringify(state_(s)),encoded=Utilities.base64EncodeWebSafe(text,Utilities.Charset.UTF_8),chunks=[];for(let i=0;i<encoded.length;i+=PD.chunk)chunks.push(encoded.slice(i,i+PD.chunk));let digest=hash_(text),at=new Date().toISOString(),rows=[['BEGIN',revision,chunks.length,digest,at,saveId]];chunks.forEach((x,i)=>rows.push(['DATA',revision,i,'B64:'+x,'','']));rows.push(['COMMIT',revision,chunks.length,digest,at,saveId]);let sh=sheet_(ss,PD.snapshot,['Kind','Revision','Chunks / index','Checksum / data','Saved at','Save request ID']);let start=sh.getLastRow()+1;if(start+rows.length-1>sh.getMaxRows())sh.insertRowsAfter(sh.getMaxRows(),start+rows.length-1-sh.getMaxRows());sh.getRange(start,1,rows.length,6).setValues(rows);SpreadsheetApp.flush();let check=latest_(ss);if(check.revision!==revision||check.saveId!==saveId)throw Error('INTEGRITY: Save verification failed.');return check;}
function cell_(v){if(v===null||v===undefined)return '';if(typeof v==='boolean'||typeof v==='number')return v;let s=String(v);return /^[\s\uFEFF]*[=+@\-]/.test(s)?"'"+s:s}
function table_(ss,name,headers,rows){let sh=sheet_(ss,name,headers);let values=[headers,...rows].map(r=>r.map(cell_));if(values.length>sh.getMaxRows())sh.insertRowsAfter(sh.getMaxRows(),values.length-sh.getMaxRows());sh.clearContents();sh.getRange(1,1,values.length,headers.length).setValues(values);sh.setFrozenRows(1);}
function projections_(ss,s,revision){
 table_(ss,'Clients',['ID','Client','Contact','Email','Phone'],s.clients.map(c=>[c.id,c.name,c.contact,c.email,c.phone]));
 table_(ss,'Assignments',['ID','Client ID','Title','Period','Owner','Collection due','Next follow-up','Notes'],s.assignments.map(a=>[a.id,a.clientId,a.title,a.period,a.owner,a.due,a.nextFollowUp,a.notes]));
 table_(ss,'Documents',['ID','Assignment ID','Document','Required','Status','Due override','Received on','Notes'],s.assignments.flatMap(a=>a.docs.map(d=>[d.id,a.id,d.name,d.required,d.status,d.due,d.receivedOn,d.notes])));
 table_(ss,'Contacts',['ID','Assignment ID','Contact date','Channel','Staff','Outcome','Recorded at'],s.assignments.flatMap(a=>a.followUps.map(f=>[f.id,a.id,f.date,f.channel,f.by,f.notes,f.recordedAt])));
 table_(ss,'Activity',['Timestamp','Activity'],s.activity.map(x=>[x.at,x.text]));
 let meta=ss.getSheetByName('_Meta');meta.getRange(3,1,1,2).setValues([['PROJECTION_REVISION',revision]]);
}
function quota_(){try{return {remaining:MailApp.getRemainingDailyQuota(),error:''}}catch(e){return {remaining:null,error:'Email permission unavailable. Re-authorize sending access in Google.'}}}
function metaResult_(ss,snap){return {email:identity_(),spreadsheetId:ss.getId(),spreadsheetUrl:ss.getUrl(),revision:snap.revision,at:snap.at,state:snap.state,emails:mailRows_(ss),quota:quota_(),projectionRevision:Number(ss.getSheetByName('_Meta').getRange(3,2).getValue()||0)}}
function pdBootstrap(){let email=identity_();return locked_(()=>{let ss=db_(email,false);if(!ss)return {email,needsSetup:true,quota:quota_()};return metaResult_(ss,latest_(ss))})}
function pdCreateWorkspace(){let email=identity_();return locked_(()=>{let ss=db_(email,false);if(!ss){ss=SpreadsheetApp.create('PracticeDesk - '+email);let meta=sheet_(ss,'_Meta',['Key','Value']);meta.getRange(2,1,2,2).setValues([[PD.ownerKey,email],['PROJECTION_REVISION',0]]);sheet_(ss,PD.mail,['Request ID','Payload hash','Requested at','To','Subject','Status','Updated at','Detail','Assignment ID']);appendSnapshot_(ss,empty_(),1,Utilities.getUuid());projections_(ss,empty_(),1);PropertiesService.getUserProperties().setProperty(PD.dbKey,ss.getId());}return metaResult_(ss,latest_(ss))})}
function pdSave(input,baseRevision,saveId){let email=identity_();if(typeof saveId!=='string'||!/^[A-Za-z0-9_-]{1,100}$/.test(saveId))throw Error('VALIDATION: Invalid save request ID.');let clean=state_(input);return locked_(()=>{let ss=db_(email,true),old=latest_(ss);if(old.saveId===saveId){if(hash_(JSON.stringify(old.state))!==hash_(JSON.stringify(clean)))throw Error('SAVE_ID: Request ID was reused for different data.');return {revision:old.revision,at:old.at,replayed:true,warning:''}}if(Number(baseRevision)!==old.revision)throw Error('CONFLICT: Another tab saved newer data. Export local changes, then reload the Sheet.');let snap=appendSnapshot_(ss,clean,old.revision+1,saveId),warning='';try{projections_(ss,clean,snap.revision)}catch(e){warning='Core save succeeded; readable tabs need repair. Use Repair readable tabs in Account.'}return {revision:snap.revision,at:snap.at,replayed:false,warning}})}
function pdRepairViews(){let email=identity_();return locked_(()=>{let ss=db_(email,true),snap=latest_(ss);projections_(ss,snap.state,snap.revision);return {revision:snap.revision}})}
function mailRows_(ss){let sh=ss.getSheetByName(PD.mail);if(!sh||sh.getLastRow()<2)return [];return sh.getDataRange().getValues().slice(1).filter(r=>r[0]).slice(-100).reverse().map(r=>({id:String(r[0]),to:String(r[3]),subject:String(r[4]),status:String(r[5]),at:String(r[6]),detail:String(r[7]),assignmentId:String(r[8])}))}
function pdSendEmail(req){let email=identity_();if(!req||typeof req.id!=='string'||!/^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$/.test(req.id)||!email_(req.to))throw Error('VALIDATION: A single valid recipient and request ID are required.');txt_(req.subject,'subject',200,false);txt_(req.body,'message',20000,false);if(/[\r\n]/.test(req.subject))throw Error('VALIDATION: Subject must be one line.');txt_(req.assignmentId||'','assignment ID',100,true);let fingerprint='SHA256:'+hash_(req.to.toLowerCase()+'\n'+req.subject+'\n'+req.body);return locked_(()=>{let ss=db_(email,true),sh=sheet_(ss,PD.mail,['Request ID','Payload hash','Requested at','To','Subject','Status','Updated at','Detail','Assignment ID']),rows=sh.getDataRange().getValues();
 let prior=rows.find(r=>r[0]===req.id);if(prior){if(prior[1]!==fingerprint)throw Error('REQUEST_ID: This request ID belongs to another message.');return {status:prior[5],detail:prior[7],replayed:true,emails:mailRows_(ss),quota:quota_()}}
 let recent=rows.find(r=>r[1]===fingerprint&&['Sending','Sent (accepted)','Unknown'].includes(r[5])&&(Date.now()-Date.parse(r[2]))<10*60*1000);if(recent)throw Error('DUPLICATE: An identical email was already submitted in the last 10 minutes. Check Email log; it has not been sent again.');
 if(MailApp.getRemainingDailyQuota()<1)throw Error('QUOTA: Google reports no email-recipient quota remaining. Nothing was submitted.');
 if(req.assignmentId&&!latest_(ss).state.assignments.some(a=>a.id===req.assignmentId))throw Error('VALIDATION: Assignment no longer exists. Reload before sending.');
 let now=new Date().toISOString(),row=sh.getLastRow()+1,record=[req.id,fingerprint,now,req.to,req.subject,'Sending',now,'Submission started; if interrupted, do not automatically resend.',req.assignmentId||''];if(row>sh.getMaxRows())sh.insertRowsAfter(sh.getMaxRows(),1);sh.getRange(row,1,1,9).setValues([record.map(cell_)]);SpreadsheetApp.flush();
 // Reservation is persisted before MailApp. A response loss never triggers an automatic resend.
 let status,detail;try{MailApp.sendEmail({to:req.to,subject:req.subject,body:req.body,name:'PracticeDesk',replyTo:email});status='Sent (accepted)';detail='Google accepted the send request. Delivery and reading are not tracked.'}catch(e){status='Unknown';detail='Send outcome could not be confirmed. Check the recipient / account before trying a new request. '+String(e.message||e).slice(0,250)}
 try{sh.getRange(row,6,1,3).setValues([[status,new Date().toISOString(),detail]]);SpreadsheetApp.flush()}catch(e){return {status:'Unknown',detail:'Email processing occurred but final log update failed. Check the recipient before any new send.',emails:mailRows_(ss),quota:quota_()}}
 return {status,detail,replayed:false,emails:mailRows_(ss),quota:quota_()};
 })}
function pdSelfTest(){let email=identity_();return locked_(()=>{let ss=db_(email,true),snap=latest_(ss),q=quota_();return {identity:email,revision:snap.revision,spreadsheetUrl:ss.getUrl(),snapshotVerified:true,readableTabsCurrent:Number(ss.getSheetByName('_Meta').getRange(3,2).getValue())===snap.revision,emailPermission:q.error?'Missing':'Available',remainingRecipients:q.remaining,sentTestEmail:false}})}
