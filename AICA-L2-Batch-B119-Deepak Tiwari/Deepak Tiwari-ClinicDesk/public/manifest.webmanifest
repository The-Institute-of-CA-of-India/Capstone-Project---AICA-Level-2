{
  "name": "Clinic Manager",
  "short_name": "Clinic",
  "description": "Patients, appointments, visits, billing and reports for a clinic.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0c2a3a",
  "theme_color": "#0c2a3a",
  "lang": "en",
  "categories": ["medical", "business", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Patients", "url": "/#/patients", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Appointments", "url": "/#/appointments", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Billing", "url": "/#/billing", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
