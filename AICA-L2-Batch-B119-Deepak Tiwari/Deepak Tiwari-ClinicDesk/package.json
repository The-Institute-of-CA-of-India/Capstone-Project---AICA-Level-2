{
  "name": "clinicdesk",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-country (Kenya / India) clinic management PWA on Firebase",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "sharp": "^0.35.5",
    "typescript": "^5.6.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
